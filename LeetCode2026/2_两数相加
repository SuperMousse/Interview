/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* pHead = nullptr;
        ListNode* pPre = nullptr;
        int residual = 0;
        int carry = 0;
        while (l1 != nullptr || l2 != nullptr) {
            int value1 = (l1 == nullptr) ? 0 : l1->val;
            int value2 = (l2 == nullptr) ? 0 : l2->val;
            int value = value1 + value2 + carry;
            residual = value % 10;
            carry = value / 10;
            ListNode* pTemp = new ListNode(residual, nullptr);
            if (pHead == nullptr) {
                pHead = pTemp;
                pPre = pTemp;
            } else {
                pPre->next = pTemp;
                pPre = pPre->next;
            }
            if (l1 != nullptr) {
                l1 = l1->next;
            }
            if (l2 != nullptr) {
                l2 = l2->next;
            }
        }
        if (carry > 0) {
            pPre->next = new ListNode(carry);
        }
        return pHead;
    }
};
